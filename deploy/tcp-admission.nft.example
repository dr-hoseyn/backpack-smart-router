add table ip backpack_router_tcp_admission
delete table ip backpack_router_tcp_admission

table ip backpack_router_tcp_admission {
    set per_source {
        type ipv4_addr
        flags dynamic,timeout
        timeout 30s
        size 65536
    }

    chain public_tcp {
        type filter hook prerouting priority mangle; policy accept;
        iifname "eth0" ip daddr 203.0.113.10 tcp dport 8443 ct state new tcp flags syn / fin,syn,rst,ack jump admit
    }

    chain admit {
        ct mark & 0x10000000 != 0 return
        update @per_source { ip saddr limit rate over 12/second burst 30 packets } counter drop
        limit rate over 480/second burst 600 packets counter drop
        ct mark set ct mark | 0x10000000 counter
    }
}
