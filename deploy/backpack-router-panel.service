[Unit]
Description=BackPack Smart Router management plane
After=network.target backpack-router-engine.service

[Service]
User=backpack-panel
Group=backpack-router
UMask=0077
EnvironmentFile=-/etc/backpack-router/panel.env
ExecStart=/opt/backpack-router/current/backpack-router panel $PANEL_ARGS
Restart=on-failure
RestartSec=2
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
ReadWritePaths=/var/lib/backpack-router/config /var/lib/backpack-router/panel
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK

[Install]
WantedBy=multi-user.target
