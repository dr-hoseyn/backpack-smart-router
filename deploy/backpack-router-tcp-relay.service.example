[Unit]
Description=BackPack Smart Router TCP relay to a private backend

[Service]
ExecStart=/usr/lib/systemd/systemd-socket-proxyd --connections-max=4096 10.0.0.11:8443
LimitNOFILE=32768
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_INET AF_UNIX
