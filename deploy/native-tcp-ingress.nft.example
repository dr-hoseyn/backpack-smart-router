table ip backpack_router_native_tcp {
    chain forward_new_tcp {
        type nat hook prerouting priority dstnat; policy accept;
        iifname "eth0" ip daddr 203.0.113.10 tcp dport 8443 tcp flags syn / fin,syn,rst,ack counter dnat to 10.0.0.2:8443
    }

    chain protect_private_listener {
        type filter hook input priority filter; policy accept;
        ip daddr 10.0.0.2 tcp dport 8443 ct original ip daddr != 203.0.113.10 counter drop
    }
}
