[Unit]
Description=BackPack Smart Router data plane
After=network.target

[Service]
User=backpack-engine
Group=backpack-router
RuntimeDirectory=backpack-router
RuntimeDirectoryMode=0750
UMask=0027
ExecStart=/opt/backpack-router/current/backpack-router engine
Restart=on-failure
RestartSec=2
TimeoutStopSec=15
LimitNOFILE=524288
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK

[Install]
WantedBy=multi-user.target
